# Anthropic configuration (server-only, never exposed to the browser)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override the model (defaults to claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Convex configuration (optional - conversations persist in memory without it)
VITE_CONVEX_URL=your-convex-deployment-url-here

# Sentry configuration (optional)
VITE_SENTRY_DSN=your-sentry-dsn-here
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
